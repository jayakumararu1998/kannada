NODE_ENV=development
# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.kannada.mo.vc/api/public

# Bookmarks API
NEXT_PUBLIC_BOOKMARKS_API_URL=https://api.kannada.mo.vc/api/public/bookmarks

# Dynamic Routing API
ROUTE_CONFIG_API_URL=https://api.kannada.mo.vc/api/url-routing/public/config
PAGE_JSON_API_URL=https://api.kannada.mo.vc/api/pages/public

# Quintype API (for collections and stories) - domain only, /api/v1 appended by code
QUINTYPE_API_BASE_URL=https://kannadaprabha.quintype.io
# QUINTYPE_API_BASE_URL=https://kannadaprabha-demo.madrid.quintype.io
#QUINTYPE_API_BASE_URL=http://kannadaprabha.internal.quintype.io

# Media CDN URLs
MEDIA_BASE_URL=https://media.kannadaprabha.com
VIDEO_BASE_URL=https://video.assettype.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.kannadaprabha.com
API_EXTERNAL_URL=https://api.kannada.mo.vc
API_EXTERNAL_URL_LIVE=https://api.kannada.mo.vc

# Fallback Image
FALLBACK_IMAGE_PATH=kannadaprabha/2024-02/86841f97-d91a-494c-aac7-192eaf085be9/fallback.jpeg

# Panchangam API
PANCHANGAM_API_BASE_URL=https://apifeeds.kannadaprabha.com/panchangam/api

# Website Settings API
WEBSITE_SETTINGS_BASE_URL=https://api.kannada.mo.vc/api/website-settings/public

# Ads API
ADS_API_BASE_URL=https://api.kannada.mo.vc/api

# Website Domain
NEXT_PUBLIC_SITE_URL=https://www.kannadaprabha.com

# Section Meta API
SECTION_META_API_BASE_URL=https://api.kannada.mo.vc
NEXT_PUBLIC_SECTION_META_API_BASE_URL=https://api.kannada.mo.vc

# Redis Configuration (for production caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Sync API Configuration
USE_LOCAL_STORE=true
SYNC_ALLOWED_ORIGINS=https://builder.kannadaprabha.com,http://localhost:4000,https://builder.kannadaprabha.mo.vc

# Publisher Configuration
QUINTYPE_PUBLISHER_ID=5592

# Cache Purge API
CACHE_PURGE_API_KEY=kannadaprabha

# Sitemap API
SITEMAP_API_BASE_URL=https://kannadaprabha.quintype.io

# Logging
SERVICE_NAME=kannadaprabha-website
LOG_LEVEL=INFO


# Local runtime env (gitignored). Loaded by Next.js — unlike .env.example.

NEXT_PUBLIC_SITE_URL=https://www.kannadaprabha.com
MEDIA_BASE_URL=https://media.kannadaprabha.com
API_EXTERNAL_URL=https://www.kannadaprabha.com

# Builder (page-JSON) sync
BUILDER_API_URL=https://api.kannada.mo.vc
SYNC_API_KEY=kannadaprabhabuilderkey
BUILDER_STORE_PATH=./src/data/store.json

# Header / main menu
MENU_API_BASE_URL=https://www.kannadaprabha.com
HEADER_MENU_SLUG=default

# Periodic pull (0 = disabled; on-demand pull only)
BUILDER_PULL_INTERVAL_MS=0
